[Desktop Entry]
Type=Application
Name=VBoxClient Autostart
Comment=VirtualBox Guest Additions servislerini otomatik başlatır
Exec=sh -c "sleep 3 && while ! xset q >/dev/null 2>&1; do sleep 1; done; VBoxClient-all"
Terminal=false
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
StartupNotify=false
