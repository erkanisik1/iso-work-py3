insmod iso9660
insmod part_gpt
insmod part_msdos
insmod fat
insmod udf
insmod ext2
insmod gzio

function load_video {
  if [ x$feature_all_video_module = xy ]; then
    insmod all_video
  else
    insmod efi_gop
    insmod efi_uga
    insmod ieee1275_fb
    insmod vbe
    insmod vga
    insmod video_bochs
    insmod video_cirrus
  fi
}

search --set=cdrom --file /.miso
set root=$cdrom


insmod font
insmod gettext

loadfont ($root)/EFI/BOOT/grub2/themes/pisilinux/terminus-14.pf2
loadfont ($root)/EFI/BOOT/grub2/themes/pisilinux/unifont-regular-16.pf2



# Grafik Modu Ayarları
set gfxmode=auto
set gfxpayload=keep
set gfxterm_font=Unifont
load_video
insmod gfxterm
terminal_input console
terminal_output gfxterm


insmod gfxmenu
insmod png
insmod jpeg

# TEMA YÜKLEME
set theme=($root)/EFI/BOOT/grub2/themes/pisilinux/theme.txt
export theme

set timeout_style=menu
set timeout=10

set menu_color_normal=white/black
set menu_color_highlight=white/red



submenu "Türkçe" --class lang_tr {

    menuentry "PisiLinux UEFI - GPT Kurucusu" --class pisilinux {
        linux /pisi/boot/kernel rdinit=/init mudur="language:tr,live" img_dev=$img_dev img_loop=$img_loop %(iso_cmdline)s quiet splash ---
        initrd /pisi/boot/initrd
    }

    menuentry "PisiLinux UEFI - Güvenli Mod" --class pisilinux {
        linux /pisi/boot/kernel rdinit=/init mudur="language:tr,live,safe" img_dev=$img_dev img_loop=$img_loop %(iso_cmdline)s quiet splash ---
        initrd /pisi/boot/initrd
    }

    menuentry "PisiLinux UEFI - Kurtarıcı" --class recovery {
        linux /pisi/boot/kernel rdinit=/init yali=rescue img_dev=$img_dev img_loop=$img_loop %(iso_cmdline)s quiet splash ---
        initrd /pisi/boot/initrd
    }

    menuentry "Yeniden Başlat" --class restart {
        reboot
    }

    menuentry "UEFI Yapılandırması" --class efi {
        fwsetup
    }
}

submenu "English" --class lang_en_us {

    menuentry "PisiLinux UEFI - GPT Installing" --class pisilinux {
        linux /pisi/boot/kernel rdinit=/init mudur="language:en,live" img_dev=$img_dev img_loop=$img_loop %(iso_cmdline)s quiet splash ---
        initrd /pisi/boot/initrd
    }

    menuentry "PisiLinux UEFI - Safe Mode" --class pisilinux {
        linux /pisi/boot/kernel rdinit=/init mudur="language:en,live,safe" img_dev=$img_dev img_loop=$img_loop %(iso_cmdline)s quiet splash ---
        initrd /pisi/boot/initrd
    }

    menuentry "PisiLinux UEFI - Rescue" --class recovery {
        linux /pisi/boot/kernel rdinit=/init yali=rescue img_dev=$img_dev img_loop=$img_loop %(iso_cmdline)s quiet splash ---
        initrd /pisi/boot/initrd
    }

    menuentry "Restart" --class restart {
        reboot
    }

    menuentry "System setup" --class efi {
        fwsetup
    }
}
